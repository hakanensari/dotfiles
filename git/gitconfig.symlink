[user]
	name = Hakan Ensari
	email = hakanensari@gmail.com

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[core]
	excludesfile = ~/.gitignore_global
	autocrlf = input

[init]
	defaultBranch = main

[push]
	default = simple
	autoSetupRemote = true

[pull]
	rebase = true

[color]
	ui = auto

# Machine-specific settings (user.signingkey). Untracked; ignored if absent.
[include]
	path = ~/.gitconfig.local
[credential "https://git.heroku.com"]
	helper = !heroku git:credentials
