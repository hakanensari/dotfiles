[user]
	name = Hakan Ensari
	email = hakanensari@gmail.com
	signingkey = ~/.ssh/id_ed25519_github.pub

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[core]
	excludesfile = ~/.gitignore_global
	autocrlf = input

[init]
	defaultBranch = main

[push]
	default = simple
	autoSetupRemote = true

[pull]
	rebase = true

[color]
	ui = auto
