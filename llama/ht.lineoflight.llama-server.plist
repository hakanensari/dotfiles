<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ht.lineoflight.llama-server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/llama-server</string>
        <string>--models-dir</string>
        <string>/Users/hakanensari/models</string>
        <string>--models-max</string>
        <string>2</string>
        <string>--jinja</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8080</string>
        <string>-ngl</string>
        <string>999</string>
        <string>-c</string>
        <string>32768</string>
        <string>--sleep-idle-seconds</string>
        <string>300</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/Users/hakanensari/.cache/llama.cpp</string>

    <key>StandardOutPath</key>
    <string>/Users/hakanensari/.cache/llama.cpp/llama-server.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/hakanensari/.cache/llama.cpp/llama-server.err.log</string>
</dict>
</plist>
