#!/usr/bin/env bash
#
# bootstrap - Idempotently symlink dotfiles into $HOME

set -e

DOTFILES_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="$HOME/.local/bin:$PATH"

echo "Bootstrapping dotfiles from $DOTFILES_ROOT..."

# Find all *.symlink files and link them into $HOME
find "$DOTFILES_ROOT" -name "*.symlink" | while read -r src; do
  file="$(basename "$src" .symlink)"
  target="$HOME/.$file"

  if [ -h "$target" ]; then
    echo "  [skip] Symlink already exists: $target"
  elif [ -f "$target" ] || [ -d "$target" ]; then
    echo "  [backup] Backing up existing $target -> $target.backup"
    mv "$target" "$target.backup"
    ln -s "$src" "$target"
    echo "  [link] Linked $src -> $target"
  else
    ln -s "$src" "$target"
    echo "  [link] Linked $src -> $target"
  fi
done

# Symlink ~/.config/mise/config.toml
mkdir -p "$HOME/.config/mise"
if [ ! -h "$HOME/.config/mise/config.toml" ]; then
  if [ -f "$HOME/.config/mise/config.toml" ]; then
    mv "$HOME/.config/mise/config.toml" "$HOME/.config/mise/config.toml.backup"
  fi
  ln -s "$DOTFILES_ROOT/mise/config.toml" "$HOME/.config/mise/config.toml"
  echo "  [link] Linked mise/config.toml -> ~/.config/mise/config.toml"
fi

# Symlink ~/.config/direnv/ settings and direnvrc
mkdir -p "$HOME/.config/direnv"
if [ -d "$DOTFILES_ROOT/direnv" ]; then
  for f in "$DOTFILES_ROOT/direnv"/*; do
    name="$(basename "$f")"
    target="$HOME/.config/direnv/$name"
    if [ ! -h "$target" ]; then
      if [ -f "$target" ]; then
        mv "$target" "$target.backup"
      fi
      ln -s "$f" "$target"
      echo "  [link] Linked direnv/$name -> ~/.config/direnv/$name"
    fi
  done
fi

# Symlink ~/.config/zed/ settings and keymap
mkdir -p "$HOME/.config/zed"
if [ -d "$DOTFILES_ROOT/zed" ]; then
  for f in "$DOTFILES_ROOT/zed"/*; do
    name="$(basename "$f")"
    target="$HOME/.config/zed/$name"
    if [ ! -h "$target" ]; then
      if [ -f "$target" ]; then
        mv "$target" "$target.backup"
      fi
      ln -s "$f" "$target"
      echo "  [link] Linked zed/$name -> ~/.config/zed/$name"
    fi
  done
fi

# Symlink ~/.config/herdr/ settings
mkdir -p "$HOME/.config/herdr"
if [ -d "$DOTFILES_ROOT/herdr" ]; then
  for f in "$DOTFILES_ROOT/herdr"/*; do
    name="$(basename "$f")"
    target="$HOME/.config/herdr/$name"
    if [ ! -h "$target" ]; then
      if [ -f "$target" ]; then
        mv "$target" "$target.backup"
      fi
      ln -s "$f" "$target"
      echo "  [link] Linked herdr/$name -> ~/.config/herdr/$name"
    fi
  done
fi

# Symlink ~/.ssh/allowed_signers (public keys only; git needs it to verify signatures)
mkdir -p "$HOME/.ssh"
if [ -f "$DOTFILES_ROOT/ssh/allowed_signers" ] && [ ! -h "$HOME/.ssh/allowed_signers" ]; then
  if [ -f "$HOME/.ssh/allowed_signers" ]; then
    mv "$HOME/.ssh/allowed_signers" "$HOME/.ssh/allowed_signers.backup"
  fi
  ln -s "$DOTFILES_ROOT/ssh/allowed_signers" "$HOME/.ssh/allowed_signers"
  echo "  [link] Linked ssh/allowed_signers -> ~/.ssh/allowed_signers"
fi

# Symlink ~/.agents/skills for global agent access across all projects
if [ -d "$DOTFILES_ROOT/agents/skills" ]; then
  mkdir -p "$HOME/.agents/skills"
  for s in "$DOTFILES_ROOT/agents/skills"/*; do
    name="$(basename "$s")"
    target="$HOME/.agents/skills/$name"
    if [ ! -h "$target" ]; then
      if [ -d "$target" ] || [ -f "$target" ]; then
        mv "$target" "$target.backup"
      fi
      ln -s "$s" "$target"
      echo "  [link] Linked agents/skills/$name -> ~/.agents/skills/$name"
    fi
  done
fi

# Symlink ~/.config/AGENTS.md
mkdir -p "$HOME/.config"
if [ -f "$DOTFILES_ROOT/agents/AGENTS.md" ]; then
  target="$HOME/.config/AGENTS.md"
  if [ ! -h "$target" ]; then
    if [ -f "$target" ]; then
      mv "$target" "$target.backup"
    fi
    ln -s "$DOTFILES_ROOT/agents/AGENTS.md" "$target"
    echo "  [link] Linked agents/AGENTS.md -> ~/.config/AGENTS.md"
  fi
fi

# Symlink agent instructions into tool directories
mkdir -p "$HOME/.claude" "$HOME/.codex" "$HOME/.gemini"

if [ ! -h "$HOME/.claude/CLAUDE.md" ]; then
  [ -f "$HOME/.claude/CLAUDE.md" ] && mv "$HOME/.claude/CLAUDE.md" "$HOME/.claude/CLAUDE.md.backup"
  ln -s "$HOME/.config/AGENTS.md" "$HOME/.claude/CLAUDE.md"
  echo "  [link] Linked ~/.config/AGENTS.md -> ~/.claude/CLAUDE.md"
fi

if [ ! -h "$HOME/.codex/AGENTS.md" ]; then
  [ -f "$HOME/.codex/AGENTS.md" ] && mv "$HOME/.codex/AGENTS.md" "$HOME/.codex/AGENTS.md.backup"
  ln -s "$HOME/.config/AGENTS.md" "$HOME/.codex/AGENTS.md"
  echo "  [link] Linked ~/.config/AGENTS.md -> ~/.codex/AGENTS.md"
fi

if [ ! -h "$HOME/.gemini/GEMINI.md" ]; then
  [ -f "$HOME/.gemini/GEMINI.md" ] && mv "$HOME/.gemini/GEMINI.md" "$HOME/.gemini/GEMINI.md.backup"
  ln -s "$HOME/.config/AGENTS.md" "$HOME/.gemini/GEMINI.md"
  echo "  [link] Linked ~/.config/AGENTS.md -> ~/.gemini/GEMINI.md"
fi

# Symlink ~/.gemini/antigravity-cli/ settings and keybindings
mkdir -p "$HOME/.gemini/antigravity-cli"
if [ -d "$DOTFILES_ROOT/agy" ]; then
  for f in "$DOTFILES_ROOT/agy"/*; do
    name="$(basename "$f")"
    target="$HOME/.gemini/antigravity-cli/$name"
    if [ ! -h "$target" ]; then
      if [ -f "$target" ]; then
        mv "$target" "$target.backup"
      fi
      ln -s "$f" "$target"
      echo "  [link] Linked agy/$name -> ~/.gemini/antigravity-cli/$name"
    fi
  done
fi

# Symlink ~/.codex/config.toml
mkdir -p "$HOME/.codex"
if [ -f "$DOTFILES_ROOT/codex/config.toml" ] && [ ! -h "$HOME/.codex/config.toml" ]; then
  if [ -f "$HOME/.codex/config.toml" ]; then
    mv "$HOME/.codex/config.toml" "$HOME/.codex/config.toml.backup"
  fi
  ln -s "$DOTFILES_ROOT/codex/config.toml" "$HOME/.codex/config.toml"
  echo "  [link] Linked codex/config.toml -> ~/.codex/config.toml"
fi

# Symlink scripts from dotfiles/bin into ~/.local/bin
mkdir -p "$HOME/.local/bin"
if [ -d "$DOTFILES_ROOT/bin" ]; then
  find "$DOTFILES_ROOT/bin" -type f | while read -r script; do
    name="$(basename "$script")"
    target="$HOME/.local/bin/$name"
    if [ ! -h "$target" ]; then
      if [ -f "$target" ]; then
        mv "$target" "$target.backup"
      fi
      ln -s "$script" "$target"
      echo "  [link] Linked bin/$name -> ~/.local/bin/$name"
    fi
  done
fi

# Install mise and declared runtimes
if ! command -v mise >/dev/null 2>&1; then
  echo "Installing standalone mise..."
  curl -fsSL https://mise.run | sh
fi

if command -v mise >/dev/null 2>&1; then
  echo "Installing declared runtimes via mise..."
  mise install
fi

# Initialize RTK hooks and instructions
if command -v rtk >/dev/null 2>&1; then
  echo "Initializing RTK..."
  rtk init -g --auto-patch >/dev/null 2>&1 || true
fi

echo "Bootstrap complete!"
