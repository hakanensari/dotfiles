#!/usr/bin/env bash
#
# bootstrap - Idempotently symlink dotfiles into $HOME

set -e

DOTFILES_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

echo "Bootstrapping dotfiles from $DOTFILES_ROOT..."

# Find all *.symlink files and link them into $HOME
find "$DOTFILES_ROOT" -name "*.symlink" | while read -r src; do
  file="$(basename "$src" .symlink)"
  target="$HOME/.$file"

  if [ -h "$target" ]; then
    echo "  [skip] Symlink already exists: $target"
  elif [ -f "$target" ] || [ -d "$target" ]; then
    echo "  [backup] Backing up existing $target -> $target.backup"
    mv "$target" "$target.backup"
    ln -s "$src" "$target"
    echo "  [link] Linked $src -> $target"
  else
    ln -s "$src" "$target"
    echo "  [link] Linked $src -> $target"
  fi
done

# Symlink ~/.config/mise/config.toml
mkdir -p "$HOME/.config/mise"
if [ ! -h "$HOME/.config/mise/config.toml" ]; then
  if [ -f "$HOME/.config/mise/config.toml" ]; then
    mv "$HOME/.config/mise/config.toml" "$HOME/.config/mise/config.toml.backup"
  fi
  ln -s "$DOTFILES_ROOT/mise/config.toml" "$HOME/.config/mise/config.toml"
  echo "  [link] Linked mise/config.toml -> ~/.config/mise/config.toml"
fi

# Symlink ~/.config/direnv/ settings and direnvrc
mkdir -p "$HOME/.config/direnv"
if [ -d "$DOTFILES_ROOT/direnv" ]; then
  for f in "$DOTFILES_ROOT/direnv"/*; do
    name="$(basename "$f")"
    target="$HOME/.config/direnv/$name"
    if [ ! -h "$target" ]; then
      if [ -f "$target" ]; then
        mv "$target" "$target.backup"
      fi
      ln -s "$f" "$target"
      echo "  [link] Linked direnv/$name -> ~/.config/direnv/$name"
    fi
  done
fi

# Symlink ~/.config/zed/ settings and keymap
mkdir -p "$HOME/.config/zed"
if [ -d "$DOTFILES_ROOT/zed" ]; then
  for f in "$DOTFILES_ROOT/zed"/*; do
    name="$(basename "$f")"
    target="$HOME/.config/zed/$name"
    if [ ! -h "$target" ]; then
      if [ -f "$target" ]; then
        mv "$target" "$target.backup"
      fi
      ln -s "$f" "$target"
      echo "  [link] Linked zed/$name -> ~/.config/zed/$name"
    fi
  done
fi

# Symlink ~/.agents/skills for global agent access across all projects
if [ -d "$DOTFILES_ROOT/agents/skills" ]; then
  mkdir -p "$HOME/.agents/skills"
  for s in "$DOTFILES_ROOT/agents/skills"/*; do
    name="$(basename "$s")"
    target="$HOME/.agents/skills/$name"
    if [ ! -h "$target" ]; then
      if [ -d "$target" ] || [ -f "$target" ]; then
        mv "$target" "$target.backup"
      fi
      ln -s "$s" "$target"
      echo "  [link] Linked agents/skills/$name -> ~/.agents/skills/$name"
    fi
  done
fi

# Symlink scripts from dotfiles/bin into ~/.local/bin
mkdir -p "$HOME/.local/bin"
if [ -d "$DOTFILES_ROOT/bin" ]; then
  find "$DOTFILES_ROOT/bin" -type f | while read -r script; do
    name="$(basename "$script")"
    target="$HOME/.local/bin/$name"
    if [ ! -h "$target" ]; then
      if [ -f "$target" ]; then
        mv "$target" "$target.backup"
      fi
      ln -s "$script" "$target"
      echo "  [link] Linked bin/$name -> ~/.local/bin/$name"
    fi
  done
fi

# Install declared runtimes via mise
if command -v mise >/dev/null 2>&1; then
  echo "Installing declared runtimes via mise..."
  mise install
fi

echo "Bootstrap complete!"
